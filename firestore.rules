rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function active(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.suspended != true;
    }
    function validProfileCreate() {
      return request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt', 'suspended']) &&
        request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt', 'suspended']) &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 70 &&
        request.resource.data.suspended == false;
    }
    function validCalendar() {
      return request.resource.data.keys().hasOnly(['version', 'anchorDate', 'anchorPosition', 'days', 'plans', 'cash', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['version', 'anchorDate', 'anchorPosition', 'days', 'plans', 'cash']) &&
        request.resource.data.version == 2 &&
        request.resource.data.anchorDate is string &&
        request.resource.data.anchorPosition is int &&
        request.resource.data.anchorPosition >= 1 && request.resource.data.anchorPosition <= 6 &&
        request.resource.data.days is map &&
        request.resource.data.cash is map &&
        request.resource.data.plans is map;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid) && validProfileCreate();
      // User can edit only displayName; admin can change suspension only.
      allow update: if (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) &&
          request.resource.data.displayName is string && request.resource.data.displayName.size() <= 70)
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended']) &&
          request.resource.data.suspended is bool);
      allow delete: if false;
      match /data/{documentId} {
        allow get: if documentId == 'calendar' && ((owner(uid) && active(uid)) || admin());
        allow list: if false;
        allow create, update: if documentId == 'calendar' && owner(uid) && active(uid) && validCalendar();
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
